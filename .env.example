# Dexter's runtime configuration (M5 plan D32).
#
# The Docker image contains no settings for any environment. These two values are read when the
# container starts. If either is missing or doesn't match its rule, the container stops with a
# message saying which one is wrong.
#
# With `docker compose up`, both are optional: compose.yaml falls back to the values below.
# To change them, copy this file to .env (never committed) and edit it.
# On the deployed site they are set by the hosting platform (M5 plan, step R7).

# Shown in the app's footer. 1 to 20 lower-case letters, digits or dashes, starting with a letter.
DEXTER_ENVIRONMENT=local

# Where the app fetches Pokémon data. https:// only, lower-case host, no trailing slash.
# Its origin (https://pokeapi.co) also becomes the only address allowed by the CSP's connect-src.
DEXTER_API_BASE_URL=https://pokeapi.co/api/v2
